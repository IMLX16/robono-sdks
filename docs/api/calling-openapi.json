{
  "openapi": "3.0.3",
  "info": {
    "title": "Robono Voice Calling API",
    "version": "1",
    "description": "Use the serviceUrl returned by your calling admission request. All timestamps and durations are milliseconds. Obtain calling access and SDK details through your Robono workspace. Backend admission is documented at /docs#calling. A calling session token is distinct from your network API key."
  },
  "servers": [
    {
      "url": "https://transcode.robono.com/calling/v1",
      "description": "Calling service; use the URL returned by admission"
    },
    {
      "url": "https://transcode.robono.com/calling-test/v1",
      "description": "Isolated calling service; use only when returned by admission"
    }
  ],
  "paths": {
    "/sessions": {
      "post": {
        "operationId": "calling_sessions",
        "summary": "Create a connection-scoped or global session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticket": {
                    "type": "string"
                  },
                  "connectionId": {
                    "type": "string"
                  }
                },
                "required": [
                  "ticket"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "expiresAt": {
                      "type": "integer",
                      "format": "int64"
                    }
                  },
                  "required": [
                    "token",
                    "expiresAt"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Expired or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Access denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Call not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Call state conflict or peer unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
