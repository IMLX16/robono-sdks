  "components": {
    "securitySchemes": {
      "callingSession": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Description": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "offer",
              "answer"
            ]
          },
          "sdp": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "sdp"
        ]
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string"
          },
          "sdpMid": {
            "type": "string"
          },
          "sdpMLineIndex": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "candidate",
          "sdpMid",
          "sdpMLineIndex"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Call": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          },
          "connectionId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ringing",
              "connecting",
              "connected",
              "ended"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "caller",
              "callee"
            ]
          },
          "controlled": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "ringExpiresAt": {
            "type": "integer",
            "format": "int64"
          },
          "answeredAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "connectedAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "endedAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "remoteDescription": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Description"
              }
            ],
            "nullable": true
          },
          "remoteCandidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          }
        },
        "required": [
          "id",
          "version",
          "connectionId",
          "state",
          "role",
          "controlled",
          "createdAt",
          "remoteDescription",
          "remoteCandidates"
        ]
      },
      "HistoryEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "connectionId": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "caller",
              "callee"
            ]
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "answeredAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "connectedAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "endedAt": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "reason": {
            "type": "string"
          },
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "durationMs": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "id",
          "sequence",
          "connectionId",
          "role",
          "reason",
          "createdAt",
          "answeredAt",
          "connectedAt",
          "endedAt",
          "durationMs"
        ]
      },
      "CallingWebhook": {
        "type": "object",
        "description": "Delivered to the receiving network\u2019s signed webhook. ISO timestamps apply to webhooks. Enable through the admission endpoint using operation notifications. See /docs#calling.",
        "required": [
          "event",
          "event_id",
          "request_id",
          "created_at",
          "recipient",
          "call"
        ],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "calling.incoming",
              "calling.dismissed"
            ]
          },
          "event_id": {
            "type": "string",
            "description": "Stable across retries; deduplicate durably."
          },
          "request_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "recipient": {
            "type": "object",
            "required": [
              "child_app_id",
              "external_user_id"
            ],
            "properties": {
              "child_app_id": {
                "type": "string",
                "format": "uuid"
              },
              "external_user_id": {
                "type": "string"
              }
            }
          },
          "call": {
            "type": "object",
            "required": [
              "id",
              "connection_id",
              "created_at",
              "ring_expires_at",
              "sequence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "connection_id": {
                "type": "string",
                "description": "app:conversationId or bridge:connectionId."
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "ring_expires_at": {
                "type": "string",
                "format": "date-time",
                "description": "Never ring after this deadline."
              },
              "sequence": {
                "type": "integer",
                "enum": [
                  1,
                  2
                ],
                "description": "1 incoming; 2 dismissed. Retain the highest sequence for each call for at least 24 hours."
              },
              "reason": {
                "type": "string",
                "description": "Present for dismissal. answered clears other invitations without ending the answering device\u2019s call."
              }
            }
          }
        }
      },
      "CallingNotificationSettings": {
        "type": "object",
        "required": [
          "enabled",
          "events"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "calling.incoming",
                "calling.dismissed"
              ]
            }
          }
        }
      }
    }
  }
}
