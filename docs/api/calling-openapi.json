    "/ice": {
      "post": {
        "operationId": "calling_ice",
        "summary": "Get ICE servers and relay availability",
        "security": [
          {
            "callingSession": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
