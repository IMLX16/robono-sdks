            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "iceServers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "urls": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          "username": {
                            "type": "string"
                          },
                          "credential": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "urls"
                        ]
                      }
                    },
                    "relayAvailable": {
                      "type": "boolean"
                    },
                    "expiresAt": {
                      "type": "integer",
                      "format": "int64"
                    }
                  },
                  "required": [
                    "iceServers",
